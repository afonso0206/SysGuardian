# Cache
data/cache/*
!data/cache/.gitkeep

# Histórico local
data/history/*
!data/history/.gitkeep

# Dependências de terceiros
vendor/*
!vendor/.gitkeep

# Logs
*.log

# Arquivos temporários
*.tmp
*.bak
*.swp
*.swo
*~

# Sistema
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# Node (caso seja utilizado futuramente)
node_modules/

