# CORREÇÃO: Docker usando docker inspect --format para extração eficiente
check_docker() {
    if ! command -v docker &>/dev/null; then
        log_entry "Docker" "INFO" "Docker não instalado"
        return
    fi
    log_entry "Docker" "HEADER" "Docker"

    if ! run_cmd systemctl is-active --quiet docker; then
        log_entry "Docker" "ERROR" "Daemon Docker inativo"
        score_sub "Docker" 20
        return
    fi
    log_entry "Docker" "OK" "Daemon Docker ativo"

    local total=$(run_cmd docker ps -a -q 2>/dev/null | wc -l)
    local running=$(run_cmd docker ps -q 2>/dev/null | wc -l)
    local unhealthy=$(run_cmd docker ps --filter "health=unhealthy" -q 2>/dev/null | wc -l)
    local restarting=$(run_cmd docker ps --filter "status=restarting" -q 2>/dev/null | wc -l)

    log_entry "Docker" "INFO" "Containers: $total total, $running rodando"
    
    if [[ "$(safe_int "$unhealthy")" -gt 0 ]]; then
        log_entry "Docker" "WARN" "$unhealthy container(s) com status unhealthy"
        score_sub "Docker" 10
    fi
    if [[ "$(safe_int "$restarting")" -gt 0 ]]; then
        log_entry "Docker" "ERROR" "$restarting container(s) em loop de restart"
        score_sub "Docker" 15
    fi

    log_entry "Docker" "SUB" "Detalhes de Containers (Healthcheck & Restart)"
    # CORREÇÃO: Usar docker inspect --format para extração eficiente
    local containers=$(run_cmd docker ps -a --format "{{.Names}}" 2>/dev/null | head -10)
    if [[ -n "$containers" ]]; then
        echo "$containers" | while read -r cname; do
            [[ -z "$cname" ]] && continue
            
            # Usar --format para extrair todas as informações de uma vez
            local inspect_data=$(run_cmd docker inspect --format '{{.Name}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}|{{.HostConfig.RestartPolicy.Name}}|{{.HostConfig.RestartPolicy.MaximumRetryCount}}|{{.RestartCount}}' "$cname" 2>/dev/null)
            
            if [[ -n "$inspect_data" ]]; then
                IFS='|' read -r name health restart_policy max_retry restart_count <<< "$inspect_data"
                # Remover / do nome
                name="${name#/}"
                
                log_entry "Docker" "INFO" "  $name | Health: $health | Restart: $restart_policy (max: $max_retry) | Count: $restart_count"
                
                if [[ "$(safe_int "$restart_count")" -gt 5 ]]; then
                    log_entry "Docker" "WARN" "Container $name reiniciado $restart_count vezes"
                fi
            else
                log_entry "Docker" "INFO" "  $name | Informações não disponíveis"
            fi
        done
    fi

    local dangling_vols=$(run_cmd docker volume ls -qf dangling=true 2>/dev/null | wc -l)
    [[ "$(safe_int "$dangling_vols")" -gt 0 ]] && log_entry "Docker" "WARN" "$dangling_vols volumes órfãos detectados"

    local dangling_imgs=$(run_cmd docker images -qf dangling=true 2>/dev/null | wc -l)
    [[ "$(safe_int "$dangling_imgs")" -gt 0 ]] && log_entry "Docker" "WARN" "$dangling_imgs imagens órfãs (dangling) detectadas"

    log_entry "Docker" "SUB" "Uso de Espaço Docker"
    run_cmd docker system df 2>/dev/null | while read -r line; do
        [[ -n "$line" ]] && log_entry "Docker" "INFO" "  $line"
    done
}

check_apache() {
    if ! command -v apache2ctl &>/dev/null; then
        log_entry "Apache" "INFO" "Apache não instalado"
        return
    fi
    log_entry "Apache" "HEADER" "Apache HTTP Server"

    if ! run_cmd systemctl is-active --quiet apache2; then
        log_entry "Apache" "ERROR" "Serviço Apache inativo"
        score_sub "Apache" 20
        return
    fi
    log_entry "Apache" "OK" "Serviço Apache ativo"

    local conf_test=$(run_cmd apache2ctl -t 2>&1)
    if echo "$conf_test" | grep -q 'Syntax OK'; then
        log_entry "Apache" "OK" "Sintaxe da configuração: OK"
    else
        log_entry "Apache" "ERROR" "Erro de sintaxe: $conf_test"
        score_sub "Apache" 15
    fi

    log_entry "Apache" "SUB" "Configurações do Servidor"
    local server_tokens=$(run_cmd apache2ctl -V 2>/dev/null | grep -i 'Server Tokens' | awk '{print $4}' || echo "N/A")
    local server_signature=$(run_cmd apache2ctl -V 2>/dev/null | grep -i 'Server Signature' | awk '{print $4}' || echo "N/A")
    log_entry "Apache" "INFO" "ServerTokens: $server_tokens | ServerSignature: $server_signature"
    
    if [[ "$server_tokens" == "Prod" || "$server_tokens" == "ProductOnly" ]]; then
        log_entry "Apache" "OK" "ServerTokens configurado de forma segura (Prod)"
    else
        log_entry "Apache" "WARN" "ServerTokens pode estar expondo informações (não é 'Prod')"
    fi

    local keepalive=$(run_cmd grep -i '^KeepAlive' /etc/apache2/apache2.conf 2>/dev/null | head -1 | awk '{print $2}' || echo "N/A")
    log_entry "Apache" "INFO" "KeepAlive: ${keepalive:-N/A (padrão)}"

    local mpm=$(run_cmd apache2ctl -M 2>/dev/null | grep -oE 'mpm_(prefork|worker|event)' | head -1)
    log_entry "Apache" "INFO" "MPM Ativo: ${mpm:-N/A}"

    local listen_ports=$(run_cmd grep -i '^Listen' /etc/apache2/ports.conf /etc/apache2/sites-enabled/*.conf 2>/dev/null | awk '{print $2}' | sort -u | tr '\n' ' ')
    log_entry "Apache" "INFO" "Portas Listen: ${listen_ports:-80}"

    log_entry "Apache" "SUB" "Virtual Hosts"
    run_cmd apache2ctl -S 2>/dev/null | grep -E 'namevhost|port' | head -10 | while read -r line; do
        log_entry "Apache" "INFO" "  $line"
    done

    if run_cmd apache2ctl -M 2>/dev/null | grep -q 'ssl_module'; then
        log_entry "Apache" "OK" "Módulo SSL habilitado"
        log_entry "Apache" "SUB" "Certificados SSL"
        local certs=$(run_cmd grep -rh 'SSLCertificateFile' /etc/apache2/sites-enabled/ 2>/dev/null | awk '{print $2}' | tr -d '"' | sort -u)
        for cert in $certs; do
            if [[ -f "$cert" ]]; then
                if openssl x509 -checkend 2592000 -noout -in "$cert" 2>/dev/null; then
                    local exp_date=$(openssl x509 -enddate -noout -in "$cert" 2>/dev/null | cut -d= -f2)
                    log_entry "Apache" "OK" "Certificado válido até: $exp_date ($cert)"
                else
                    log_entry "Apache" "ERROR" "Certificado EXPIRADO ou expira em < 30 dias: $cert"
                    score_sub "Apache" 15
                fi
            fi
        done
    fi
}

# CORREÇÃO: PHP com tratamento explícito de erros de permissão/acesso
check_php() {
    if ! command -v php &>/dev/null; then
        log_entry "PHP" "INFO" "PHP não instalado"
        return
    fi
    log_entry "PHP" "HEADER" "PHP"

    local version=$(run_cmd php -v 2>/dev/null | head -1)
    log_entry "PHP" "INFO" "Versão CLI: $version"

    log_entry "PHP" "SUB" "Configurações e Arquivos"
    local loaded_ini=$(run_cmd php -i 2>/dev/null | grep 'Loaded Configuration File' | awk -F' => ' '{print $2}')
    log_entry "PHP" "INFO" "Loaded php.ini (CLI): ${loaded_ini:-N/A}"

    # CORREÇÃO: Tratamento explícito de erros ao executar php -r
    local timezone=""
    if timezone=$(php -r 'echo ini_get("date.timezone");' 2>/dev/null); then
        log_entry "PHP" "INFO" "Timezone: ${timezone:-Não definido (usando padrão do sistema)}"
    else
        log_entry "PHP" "INFO" "Timezone: Não acessível (erro ao executar php -r)"
    fi

    local realpath_cache=""
    if realpath_cache=$(php -r 'echo ini_get("realpath_cache_size");' 2>/dev/null); then
        log_entry "PHP" "INFO" "Realpath Cache Size: ${realpath_cache:-N/A}"
    else
        log_entry "PHP" "INFO" "Realpath Cache Size: Não acessível"
    fi

    local mem_limit=""
    if mem_limit=$(php -r 'echo ini_get("memory_limit");' 2>/dev/null); then
        if [[ "$mem_limit" == "-1" ]]; then
            log_entry "PHP" "OK" "memory_limit = -1 (Ilimitado, configurado intencionalmente)"
        elif [[ "$mem_limit" =~ ^([0-9]+)M$ ]]; then
            local val="${BASH_REMATCH[1]}"
            if [[ "$val" -lt 128 ]]; then
                log_entry "PHP" "WARN" "memory_limit baixo: $mem_limit"
                score_sub "PHP" 5
            else
                log_entry "PHP" "OK" "memory_limit: $mem_limit"
            fi
        else
            log_entry "PHP" "INFO" "memory_limit: $mem_limit"
        fi
    else
        log_entry "PHP" "INFO" "memory_limit: Não acessível (erro ao executar php -r)"
    fi

    log_entry "PHP" "SUB" "Ambientes PHP"
    run_cmd systemctl is-active --quiet php*-fpm && log_entry "PHP" "OK" "PHP-FPM ativo" || log_entry "PHP" "INFO" "PHP-FPM inativo/não instalado"
    run_cmd apache2ctl -M 2>/dev/null | grep -q 'php' && log_entry "PHP" "OK" "Módulo PHP do Apache carregado" || log_entry "PHP" "INFO" "Módulo PHP do Apache não carregado"

    log_entry "PHP" "SUB" "OPcache"
    local opcache=""
    if opcache=$(php -r 'echo function_exists("opcache_get_status") && opcache_get_status() ? "Habilitado" : "Desabilitado";' 2>/dev/null); then
        if [[ "$opcache" == "Habilitado" ]]; then
            log_entry "PHP" "OK" "OPcache Habilitado"
            
            # CORREÇÃO: Tratamento explícito de erros nas métricas do OPcache
            local hit_rate=""
            if hit_rate=$(php -r '$s=opcache_get_status(false); echo $s ? round($s["opcache_statistics"]["opcache_hit_rate"], 2) : 0;' 2>/dev/null); then
                local mem_used=""
                if mem_used=$(php -r '$s=opcache_get_status(false); echo $s ? round($s["memory_usage"]["used_memory"]/1024/1024, 2) : 0;' 2>/dev/null); then
                    local scripts=""
                    if scripts=$(php -r '$s=opcache_get_status(false); echo $s ? $s["opcache_statistics"]["num_cached_scripts"] : 0;' 2>/dev/null); then
                        log_entry "PHP" "INFO" "OPcache Hit Rate: ${hit_rate}% | Memória Usada: ${mem_used}MB | Scripts: $scripts"
                        if safe_compare "$hit_rate" "<" "50"; then
                            log_entry "PHP" "WARN" "Hit rate do OPcache baixo (< 50%)"
                        fi
                    else
                        log_entry "PHP" "INFO" "OPcache métricas não acessíveis (erro ao ler scripts)"
                    fi
                else
                    log_entry "PHP" "INFO" "OPcache métricas não acessíveis (erro ao ler memória)"
                fi
            else
                log_entry "PHP" "INFO" "OPcache métricas não acessíveis (erro ao ler hit rate)"
            fi
        else
            log_entry "PHP" "WARN" "OPcache Desabilitado"
            score_sub "PHP" 5
        fi
    else
        log_entry "PHP" "INFO" "OPcache status não acessível (erro ao executar php -r)"
    fi

    log_entry "PHP" "SUB" "Extensões Carregadas"
    local extensions=$(run_cmd php -m 2>/dev/null | grep -v '^\[' | sort | tr '\n' ' ')
    local ext_count=$(run_cmd php -m 2>/dev/null | grep -v '^\[' | wc -l)
    log_entry "PHP" "INFO" "Total de extensões: $ext_count"
    log_entry "PHP" "INFO" "Extensões: $extensions"
}

# CORREÇÃO: MySQL com tratamento explícito de erros de autenticação
check_mysql() {
    local mysql_cmd=""
    command -v mysql &>/dev/null && mysql_cmd="mysql"
    command -v mariadb &>/dev/null && mysql_cmd="mariadb"

    if [[ -z "$mysql_cmd" ]]; then
        log_entry "MySQL" "INFO" "MySQL/MariaDB não instalado"
        return
    fi
    log_entry "MySQL" "HEADER" "Banco de Dados (MySQL/MariaDB)"

    local svc=""
    for s in mysql mysqld mariadb; do
        run_cmd systemctl is-active --quiet "$s" && svc="$s" && break
    done

    if [[ -z "$svc" ]]; then
        log_entry "MySQL" "ERROR" "Serviço de banco de dados inativo"
        score_sub "MySQL" 20
        return
    fi
    log_entry "MySQL" "OK" "Serviço $svc ativo"

    local version=$(run_cmd $mysql_cmd --version 2>/dev/null)
    log_entry "MySQL" "INFO" "Versão: $version"

    log_entry "MySQL" "SUB" "Status e Métricas"
    
    # CORREÇÃO: Tratamento explícito de erros de autenticação
    local status=""
    local mysql_error=""
    if status=$($mysql_cmd -e "SHOW GLOBAL STATUS LIKE 'Uptime'; SHOW GLOBAL STATUS LIKE 'Threads_connected'; SHOW GLOBAL STATUS LIKE 'Aborted_connections'; SHOW GLOBAL VARIABLES LIKE 'innodb_buffer_pool_size'; SHOW GLOBAL VARIABLES LIKE 'slow_query_log'; SHOW GLOBAL VARIABLES LIKE 'log_bin';" 2>&1); then
        if [[ -n "$status" ]]; then
            local uptime=$(echo "$status" | grep 'Uptime' | awk '{print $2}')
            local threads=$(echo "$status" | grep 'Threads_connected' | awk '{print $2}')
            local aborted=$(echo "$status" | grep 'Aborted_connections' | awk '{print $2}')
            local pool=$(echo "$status" | grep 'innodb_buffer_pool_size' | awk '{print $2}')
            local slow_log=$(echo "$status" | grep 'slow_query_log' | awk '{print $2}')
            local log_bin=$(echo "$status" | grep 'log_bin' | awk '{print $2}')
            
            if [[ -n "$uptime" ]]; then
                local days=$((uptime / 86400))
                local hours=$(( (uptime % 86400) / 3600 ))
                log_entry "MySQL" "INFO" "Uptime: ${days}d ${hours}h | Conexões ativas: ${threads:-N/A} | Buffer Pool: ${pool:-N/A} bytes"
                log_entry "MySQL" "INFO" "Slow Query Log: ${slow_log:-OFF} | Binary Log: ${log_bin:-OFF}"
                
                if [[ -n "$aborted" && "$(safe_int "$aborted")" -gt 100 ]]; then
                    log_entry "MySQL" "WARN" "Conexões abortadas elevadas: $aborted"
                    score_sub "MySQL" 5
                elif [[ -n "$aborted" ]]; then
                    log_entry "MySQL" "INFO" "Conexões abortadas: $aborted"
                fi
            else
                log_entry "MySQL" "INFO" "Métricas do MySQL não disponíveis (formato de saída inesperado)"
            fi
        else
            log_entry "MySQL" "INFO" "Métricas do MySQL não disponíveis (saída vazia)"
        fi
    else
        mysql_error="$status"
        # Verificar se é erro de autenticação
        if echo "$mysql_error" | grep -qi 'access denied\|error 1045\|error 1698'; then
            log_entry "MySQL" "INFO" "Métricas internas não acessíveis (requer autenticação MySQL com privilégios adequados)"
            log_entry "MySQL" "INFO" "Dica: Configure autenticação sem senha para root ou use arquivo .my.cnf"
        else
            log_entry "MySQL" "INFO" "Métricas internas não acessíveis (erro: $(echo "$mysql_error" | head -1))"
        fi
    fi
}

check_trim() {
    log_entry "TRIM" "HEADER" "TRIM (SSD/NVMe)"
    
    if run_cmd systemctl is-active --quiet fstrim.timer; then
        log_entry "TRIM" "OK" "fstrim.timer ativo (TRIM automático agendado)"
        local next_run=$(run_cmd systemctl list-timers fstrim.timer --no-legend --no-pager 2>/dev/null | awk '{print $1, $2, $3}')
        [[ -n "$next_run" ]] && log_entry "TRIM" "INFO" "Próxima execução agendada: $next_run"
    else
        log_entry "TRIM" "WARN" "fstrim.timer inativo"
        score_sub "TRIM" 10
    fi

    local last_trim=$(run_cmd journalctl -u fstrim.service --no-pager 2>/dev/null | grep -i 'discarded' | tail -1)
    [[ -n "$last_trim" ]] && log_entry "TRIM" "INFO" "Última execução do fstrim: $last_trim"

    log_entry "TRIM" "SUB" "Suporte a TRIM por dispositivo"
    run_cmd lsblk -dno NAME,ROTA,DISC-ALN,DISC-GRAN 2>/dev/null | awk '$2=="0" && $3!="0" {print "  " $1 " (Alignment: " $3 ", Granularity: " $4 ")"}' | while read -r line; do
        [[ -n "$line" ]] && log_entry "TRIM" "INFO" "$line"
    done
}

#===============================================================================
# 4. GERAÇÃO DE RELATÓRIOS (APENAS AO FINAL)
#===============================================================================

calculate_final_score() {
    local total_score=0
    local cat_count=0
    for cat in "${!CATEGORY_SCORES[@]}"; do
        total_score=$((total_score + CATEGORY_SCORES[$cat]))
        ((cat_count++))
    done
    
    local final_score=0
    if [[ "$cat_count" -gt 0 ]]; then
        final_score=$((total_score / cat_count))
    fi
    echo "$final_score"
}

get_classification() {
    local score=$1
    if [[ "$score" -ge 90 ]]; then echo "EXCELENTE"
    elif [[ "$score" -ge 75 ]]; then echo "BOM"
    elif [[ "$score" -ge 60 ]]; then echo "REGULAR"
    elif [[ "$score" -ge 40 ]]; then echo "RUIM"
    else echo "CRÍTICO"
    fi
}

generate_reports() {
    local final_score=$(calculate_final_score)
    local classification=$(get_classification "$final_score")

    {
        echo "<!DOCTYPE html><html lang='pt-BR'><head><meta charset='UTF-8'>"
        echo "<title>Relatório de Diagnóstico - $HOSTNAME</title>"
        echo "<style>"
        echo "body{font-family:Arial,sans-serif;margin:20px;color:#333;font-size:10pt}"
        echo "h1{color:#2c3e50;border-bottom:3px solid #3498db;padding-bottom:10px}"
        echo "h2{color:#34495e;border-bottom:2px solid #95a5a6;margin-top:25px}"
        echo "h3{color:#7f8c8d;margin-top:15px}"
        echo ".ok{color:#27ae60}.warn{color:#d35400;font-weight:bold}.error{color:#c0392b;font-weight:bold}.info{color:#2980b9}"
        echo ".summary{padding:15px;border-left:5px solid #3498db;background:#f8f9fa;margin:20px 0}"
        echo ".excellent{border-left-color:#27ae60;background:#e8f5e9}.critical{border-left-color:#c0392b;background:#ffebee}"
        echo "table{width:100%;border-collapse:collapse;margin:10px 0}th,td{border:1px solid #bdc3c7;padding:6px;text-align:left}"
        echo "th{background:#3498db;color:white}.footer{margin-top:30px;font-size:8pt;color:#7f8c8d;border-top:1px solid #bdc3c7;padding-top:10px}"
        echo "</style></head><body>"
        echo "<h1>Relatório de Diagnóstico do Servidor</h1>"
        echo "<div class='summary'><table>"
        echo "<tr><td><strong>Hostname:</strong></td><td>$HOSTNAME</td></tr>"
        echo "<tr><td><strong>Data:</strong></td><td>$DATE_HUMAN</td></tr>"
        echo "<tr><td><strong>Kernel:</strong></td><td>$(uname -r)</td></tr>"
        echo "<tr><td><strong>Versão do Script:</strong></td><td>$SCRIPT_VERSION</td></tr>"
        echo "</table></div>"
        
        echo "<div class='summary $( [[ "$final_score" -lt 60 ]] && echo "critical" || echo "excellent" )'>"
        echo "<h2>Resumo Final</h2>"
        echo "<table><tr><td><strong>Pontuação Geral:</strong></td><td><strong>$final_score / 100</strong></td></tr>"
        echo "<tr><td><strong>Classificação:</strong></td><td><strong>$classification</strong></td></tr></table></div>"

        echo "<h2>Pontuação por Categoria</h2><table><tr><th>Categoria</th><th>Score</th></tr>"
        for cat in "${!CATEGORY_SCORES[@]}"; do
            local score="${CATEGORY_SCORES[$cat]}"
            local color="#27ae60"
            [[ "$score" -lt 80 ]] && color="#f39c12"
            [[ "$score" -lt 60 ]] && color="#c0392b"
            echo "<tr><td>$cat</td><td style='color:$color;font-weight:bold'>$score/100</td></tr>"
        done
        echo "</table>"

        local current_header=""
        for entry in "${REPORT_DATA[@]}"; do
            IFS='|' read -r cat level msg <<< "$entry"
            
            if [[ "$level" == "HEADER" ]]; then
                echo "<h2>$msg</h2>"
                current_header="$msg"
            elif [[ "$level" == "SUB" ]]; then
                echo "<h3>$msg</h3>"
            else
                echo "<p class='$(echo "$level" | tr '[:upper:]' '[:lower:]')'><strong>[$level]</strong> $msg</p>"
            fi
        done

        echo "<div class='footer'><p>Gerado automaticamente por $SCRIPT_NAME v$SCRIPT_VERSION</p></div>"
        echo "</body></html>"
    } > "$HTML_BUF"

    mv "$HTML_BUF" "$HTML_FILE"

    {
        echo "==============================================================================="
        echo "RELATÓRIO DE DIAGNÓSTICO DO SERVIDOR"
        echo "==============================================================================="
        echo "Hostname: $HOSTNAME | Data: $DATE_HUMAN"
        echo "Pontuação Geral: $final_score/100 ($classification)"
        echo "==============================================================================="
        for entry in "${REPORT_DATA[@]}"; do
            IFS='|' read -r cat level msg <<< "$entry"
            printf "%-10s | %-8s | %s\n" "[$cat]" "[$level]" "$msg"
        done
        echo "==============================================================================="
    } > "$TXT_FILE"

    if command -v wkhtmltopdf &>/dev/null; then
        wkhtmltopdf --quiet --page-size A4 --margin-top 15mm --margin-bottom 15mm \
            --margin-left 15mm --margin-right 15mm --encoding utf-8 \
            --footer-center "[page] de [toPage]" \
            "file://$HTML_FILE" "$PDF_FILE" 2>/dev/null && \
            log_entry "System" "OK" "Relatório PDF gerado: $PDF_FILE" || \
            log_entry "System" "WARN" "Falha ao gerar PDF via wkhtmltopdf"
    else
        log_entry "System" "INFO" "wkhtmltopdf não instalado. PDF não gerado. (Execute: sudo apt install wkhtmltopdf)"
    fi

rm -f "$HTML_BUF" 2>/dev/null || true
}

generate_json_report() {

    local final_score
    final_score=$(calculate_final_score)

    local classification
    classification=$(get_classification "$final_score")

    {

        echo "{"
        echo "  \"metadata\": {"
        echo "    \"hostname\": \"$HOSTNAME\","
        echo "    \"date\": \"$DATE_HUMAN\","
        echo "    \"version\": \"$SCRIPT_VERSION\","
        echo "    \"score\": $final_score,"
        echo "    \"classification\": \"$classification\""
        echo "  },"

        echo "  \"category_scores\": {"

        local first=1

        for cat in "${!CATEGORY_SCORES[@]}"; do

            [[ $first -eq 0 ]] && echo ","

            printf '    "%s": %s' \
                "$cat" \
                "${CATEGORY_SCORES[$cat]}"

            first=0

        done

        echo
        echo "  },"

        echo "  \"entries\": ["

        first=1

        for entry in "${REPORT_DATA[@]}"; do

            IFS='|' read -r cat level msg <<< "$entry"

            msg="${msg//\\/\\\\}"
            msg="${msg//\"/\\\"}"

            [[ $first -eq 0 ]] && echo ","

            printf '    {"category":"%s","level":"%s","message":"%s"}' \
                "$cat" \
                "$level" \
                "$msg"

            first=0

        done

        echo
        echo "  ]"

        echo "}"

    } > "$JSON_FILE"

}

