#===============================================================================
# 2. FUNÇÕES UTILITÁRIAS E DE SEGURANÇA (MATEMÁTICA E CACHE)
#===============================================================================

safe_int() {
    local val="${1:-0}"
    val="${val//[^0-9-]/}"
    echo "${val:-0}"
}

safe_float() {
    local val="${1:-0}"
    val=$(echo "$val" | grep -oE '^-?[0-9]+\.?[0-9]*' | head -1)
    echo "${val:-0}"
}

safe_compare() {
    local a=$(safe_float "$1")
    local op="${2:-==}"
    local b=$(safe_float "$3")
    
    awk -v val1="$a" -v op="$op" -v val2="$b" 'BEGIN {
        if (op == "==") exit (val1 == val2) ? 0 : 1
        else if (op == "!=") exit (val1 != val2) ? 0 : 1
        else if (op == ">") exit (val1 > val2) ? 0 : 1
        else if (op == ">=") exit (val1 >= val2) ? 0 : 1
        else if (op == "<") exit (val1 < val2) ? 0 : 1
        else if (op == "<=") exit (val1 <= val2) ? 0 : 1
        else exit 1
    }'
}
run_cmd() {

    local cmd_hash

    cmd_hash="$(printf '%q ' "$@" | md5sum | cut -d' ' -f1)"

    if [[ -z "${CMD_CACHE[$cmd_hash]:-}" ]]; then

        CMD_CACHE["$cmd_hash"]="$(
            "$@" 2>/dev/null || true
        )"

    fi

    printf '%s\n' "${CMD_CACHE[$cmd_hash]}"

}
score_sub() {
    local cat="$1"
    local points="$2"
    local current="${CATEGORY_SCORES[$cat]:-100}"
    local new_score=$((current - points))
    CATEGORY_SCORES[$cat]=$(( new_score < 0 ? 0 : new_score ))
}

log_entry() {
    local cat="$1"
    local level="$2"
    local msg="$3"
    
    case "$level" in
        OK)     echo -e "${C_GREEN}[OK]${C_RESET} [$cat] $msg" ;;
        WARN)   echo -e "${C_YELLOW}[AVISO]${C_RESET} [$cat] $msg" ;;
        ERROR)  echo -e "${C_RED}[ERRO]${C_RESET} [$cat] $msg" ;;
        INFO)   echo -e "${C_BLUE}[INFO]${C_RESET} [$cat] $msg" ;;
        HEADER) echo -e "\n${C_CYAN}${C_BOLD}=== $msg ===${C_RESET}" ;;
        SUB)    echo -e "${C_CYAN}  -- $msg --${C_RESET}" ;;
    esac

    REPORT_DATA+=("${cat}|${level}|${msg}")
}

get_physical_disks() {
    run_cmd lsblk -d -n -o NAME,SIZE,MODEL,ROTA,TRAN -e 7,1,254 2>/dev/null
}

get_physical_disk_names() {
    run_cmd lsblk -d -n -o NAME -e 7,1,254 2>/dev/null
}

classify_disk() {
    local dev="$1"
    local name="${dev#/dev/}"
    local rota=$(cat "/sys/block/$name/queue/rotational" 2>/dev/null || echo "2")
    local tran=$(run_cmd lsblk -dno TRAN "$dev" 2>/dev/null | tr '[:upper:]' '[:lower:]' | xargs)
    local model=$(run_cmd lsblk -dno MODEL "$dev" 2>/dev/null | tr '[:upper:]' '[:lower:]' | xargs)

    if [[ "$name" == nvme* ]] || [[ "$tran" == "nvme" ]]; then
        echo "NVMe SSD"
    elif [[ "$rota" == "0" ]]; then
        echo "SATA SSD"
    elif [[ "$rota" == "1" ]]; then
        echo "HDD"
    elif [[ "$tran" == "usb" ]]; then
        echo "USB Storage"
    elif [[ "$model" == *"virtio"* ]] || [[ "$tran" == "virtio" ]]; then
        echo "VirtIO Disk"
    elif [[ "$model" == *"raid"* ]] || [[ "$tran" == "raid" ]] || [[ "$model" == *"logical"* ]]; then
        echo "RAID / Virtual"
    else
        echo "Storage Device"
    fi
}

