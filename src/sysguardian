check_system_and_boot() {

    log_entry "System" "HEADER" "Informações do Sistema e Boot"

    local os_info
    local kernel
    local uptime_str

    os_info="$(system_get_os)"
    kernel="$(system_get_kernel)"
    uptime_str="$(system_get_uptime)"

    log_entry "System" "INFO" "SO: $os_info"
    log_entry "System" "INFO" "Kernel: $kernel"
    log_entry "System" "INFO" "Uptime: $uptime_str"

    if system_get_reboot_required; then
        log_entry "System" "WARN" "Reinicialização pendente"
    fi

    if command_exists systemd-analyze; then

        local boot_time_raw
        
boot_time_raw="$(
    run_cmd systemd-analyze 2>/dev/null |
    awk -F'= ' 'NF>1 {print $2}' |
    sed 's/[[:space:]]*$//' ||
    true
)"
        log_entry "System" "INFO" \
            "Tempo de Boot: ${boot_time_raw:-Não disponível}"

        log_entry "System" "SUB" \
            "5 Serviços mais lentos no boot"

while IFS= read -r line; do

    [[ -n "$line" ]] &&
        log_entry "System" "INFO" "  $line"

done < <(
    run_cmd systemd-analyze blame 2>/dev/null |
    head -5
)
        log_entry "System" "SUB" \
            "Cadeia crítica do boot"

while IFS= read -r line; do

    [[ -n "$line" ]] &&
        log_entry "System" "INFO" "  $line"

done < <(
    run_cmd systemd-analyze critical-chain 2>/dev/null |
    head -8
)
    fi

}
check_cpu() {

    log_entry "CPU" "HEADER" "Processador (CPU)"

    local model
    local cores
    local load
    local temperature

    model="$(cpu_get_model)"
    cores="$(cpu_get_cores)"
    load="$(cpu_get_load_average)"
    temperature="$(cpu_get_temperature)"

    [[ -z "$model" ]] && model="Não detectado"
    [[ -z "$cores" ]] && cores="Desconhecido"
    [[ -z "$load" ]] && load="Desconhecido"

    log_entry "CPU" "INFO" "Modelo: $model"
    log_entry "CPU" "INFO" "Núcleos: $cores"
    log_entry "CPU" "INFO" "Carga: $load"

    if [[ -n "$temperature" ]]; then

        log_entry "CPU" "INFO" \
            "Temperatura: ${temperature}°C"

        if safe_compare "$temperature" ">=" "85"; then

            log_entry "CPU" "ERROR" \
                "Temperatura crítica: ${temperature}°C"

            score_sub "CPU" 15

        elif safe_compare "$temperature" ">=" "75"; then

            log_entry "CPU" "WARN" \
                "Temperatura elevada: ${temperature}°C"

            score_sub "CPU" 5

        else

            log_entry "CPU" "OK" \
                "Temperatura dentro da faixa normal (${temperature}°C)"

        fi

    else

        log_entry "CPU" "INFO" \
            "Temperatura não disponível"

    fi

}

check_memory() {

    log_entry "Memory" "HEADER" "Memória RAM e Swap"

    local total
    local used
    local avail
    local mem_pct
    local swap_total
    local swap_used
    local swap_pct
    local oom_count

    total="$(memory_get_total)"
    used="$(memory_get_used)"
    avail="$(memory_get_available)"
    mem_pct="$(memory_get_usage_percent)"

    swap_total="$(memory_get_swap_total)"
    swap_used="$(memory_get_swap_used)"

    if memory_has_swap; then
        swap_pct="$(memory_get_swap_usage_percent)"
    else
        swap_pct="0.0"
    fi

    log_entry "Memory" "INFO" \
        "Total: ${total}MB | Usada: ${used}MB (${mem_pct}%) | Disponível: ${avail}MB"

    if safe_compare "$mem_pct" ">=" "95"; then

        log_entry "Memory" "ERROR" \
            "Uso de memória crítico: ${mem_pct}%"

        score_sub "Memory" 20

    elif safe_compare "$mem_pct" ">=" "85"; then

        log_entry "Memory" "WARN" \
            "Uso de memória elevado: ${mem_pct}%"

        score_sub "Memory" 10

    else

        log_entry "Memory" "OK" \
            "Uso de memória saudável (${mem_pct}%)"

    fi

if memory_has_swap; then

    swap_pct="$(memory_get_swap_usage_percent)"

    log_entry "Memory" "INFO" \
            "Swap: ${swap_used}MB / ${swap_total}MB (${swap_pct}%)"

    if safe_compare "$swap_pct" ">=" "50"; then

        log_entry "Memory" "WARN" \
                "Uso de swap elevado: ${swap_pct}%"

       score_sub "Memory" 5

    else

            log_entry "Memory" "OK" \
                "Uso de swap normal (${swap_pct}%)"

    fi

fi

    oom_count="$(
        run_cmd dmesg 2>/dev/null |
        grep -ci 'out of memory' ||
        echo "0"
    )"

    if [[ "$(safe_int "$oom_count")" -gt 0 ]]; then

        log_entry "Memory" "ERROR" \
            "Detectados $oom_count eventos OOM (Out of Memory) no kernel"

        score_sub "Memory" 15

    fi

}
check_disks_and_lvm() {
    log_entry "Disks" "HEADER" "Armazenamento e LVM"
    
    log_entry "Disks" "SUB" "Discos Físicos (excluindo loop/ram/device-mapper)"
    local disks

    disks="$(disk_get_physical_disks)"

    while read -r name size model rota tran; do

        [[ -z "$name" ]] && continue

        local dev="/dev/$name"
        local dtype

        dtype="$(classify_disk "$dev")"

        log_entry "Disks" "INFO" \
            "$dev ($dtype) - $size - $model"

    done <<< "$disks"
    log_entry "Disks" "SUB" "Uso de Partições"
    local df_output
df_output="$(
    disk_get_partition_usage |
    grep '^/dev/' || true
)"
    if [[ -n "$df_output" ]]; then
        echo "$df_output" | while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            local src fstype size used avail pcent target
            read -r src fstype size used avail pcent target <<< "$line"
            local pct_num=$(safe_int "${pcent%\%}")
            log_entry "Disks" "INFO" "$target ($fstype): $used/$size ($pcent) livre: $avail"
            if [[ "$pct_num" -ge 95 ]]; then
                log_entry "Disks" "ERROR" "Partição $target quase cheia ($pcent)"
                score_sub "Disks" 10
            elif [[ "$pct_num" -ge 85 ]]; then
                log_entry "Disks" "WARN" "Partição $target com uso elevado ($pcent)"
                score_sub "Disks" 5
            fi
        done
    fi

    # CORREÇÃO: LVM com tratamento robusto usando --noheadings --nosuffix --units g
    if command -v vgs &>/dev/null; then
        log_entry "LVM" "SUB" "Volume Groups (LVM)"
        local vgs_output=$(run_cmd vgs --noheadings --nosuffix --units g -o vg_name,vg_size,vg_free,pv_count,lv_count 2>/dev/null)
        if [[ -n "$vgs_output" ]]; then
            echo "$vgs_output" | while read -r vg size free pv lv; do
                [[ -z "$vg" ]] && continue
                # Sanitizar valores
                vg=$(echo "$vg" | xargs)
                size=$(echo "$size" | xargs)
                free=$(echo "$free" | xargs)
                pv=$(echo "$pv" | xargs)
                lv=$(echo "$lv" | xargs)
                
                local free_num=$(safe_float "$free")
                log_entry "LVM" "INFO" "VG: $vg | Size: ${size}G | Free: ${free}G | PVs: $pv | LVs: $lv"
                
local is_thin=0

if command -v lvs &>/dev/null; then

    is_thin="$(
        run_cmd lvs --noheadings -o lv_attr "$vg" 2>/dev/null |
        grep -c '^t' || true
    )"

    is_thin="$(safe_int "$is_thin")"

fi

if safe_compare "$free_num" "<" "1.0" && [[ "$is_thin" -eq 0 ]]; then
                    log_entry "LVM" "WARN" "VG $vg com espaço livre crítico (${free}G) e sem Thin Pools"
                    score_sub "LVM" 10
                fi
            done
        fi
        
        log_entry "LVM" "SUB" "Logical Volumes (Detalhes)"
local lvs_output

lvs_output="$(
    run_cmd lvs \
        --separator '|' \
        --noheadings \
        --nosuffix \
        --units g \
        -o lv_name,vg_name,lv_size,data_percent,metadata_percent,lv_path \
        2>/dev/null
)"

        if [[ -n "$lvs_output" ]]; then
echo "$lvs_output" | while IFS= read -r line; do

    [[ -z "$line" ]] && continue

    lv=$(printf '%s\n' "$line" | cut -d'|' -f1 | xargs)
    vg=$(printf '%s\n' "$line" | cut -d'|' -f2 | xargs)
    size=$(printf '%s\n' "$line" | cut -d'|' -f3 | xargs)
    data_pct=$(printf '%s\n' "$line" | cut -d'|' -f4 | xargs)
    meta_pct=$(printf '%s\n' "$line" | cut -d'|' -f5 | xargs)
    path=$(printf '%s\n' "$line" | cut -d'|' -f6 | xargs)

    [[ -z "$data_pct" ]] && data_pct="N/A"
    [[ -z "$meta_pct" ]] && meta_pct="N/A"
if [[ "$data_pct" == "N/A" && "$meta_pct" == "N/A" ]]; then

    log_entry "LVM" "INFO" \
        "LV: $lv ($vg) | Size: ${size}G | Path: $path"

else

    log_entry "LVM" "INFO" \
        "LV: $lv ($vg) | Size: ${size}G | Data: ${data_pct}% | Meta: ${meta_pct}% | Path: $path"

fi
    if [[ "$data_pct" =~ ^[0-9]+([.][0-9]+)?$ ]]; then

        local d_pct
        d_pct="$(safe_int "$data_pct")"

        if [[ "$d_pct" -ge 90 ]]; then

            log_entry "LVM" "ERROR" \
                "LV $lv com uso de dados crítico: ${data_pct}%"

            score_sub "LVM" 10

        elif [[ "$d_pct" -ge 80 ]]; then

            log_entry "LVM" "WARN" \
                "LV $lv com uso de dados elevado: ${data_pct}%"

            score_sub "LVM" 5

        fi

    fi

done    
        fi
    fi
}

check_smart() {
    log_entry "SMART" "HEADER" "Análise SMART"
    
    if ! command -v smartctl &>/dev/null; then
        log_entry "SMART" "INFO" "SMART não verificado (smartmontools não instalado)"
        return
    fi

    local disks=$(get_physical_disk_names)
    for name in $disks; do
        local dev="/dev/$name"
        local dtype=$(classify_disk "$dev")
        log_entry "SMART" "SUB" "Disco: $dev ($dtype)"
        
        local smart_out=$(run_cmd sudo smartctl -a "$dev" 2>/dev/null)
        [[ -z "$smart_out" ]] && { log_entry "SMART" "WARN" "Falha ao ler SMART (permissão ou não suportado)"; continue; }

        if [[ "$dtype" == "NVMe SSD" ]]; then
            local crit_warn=$(echo "$smart_out" | grep -i 'Critical Warning' | awk '{print $NF}')
            local pct_used=$(echo "$smart_out" | grep -i 'Percentage Used' | grep -oE '[0-9]+')
            local avail_spare=$(echo "$smart_out" | grep -i 'Available Spare' | grep -oE '[0-9]+')
            local media_err=$(echo "$smart_out" | grep -i 'Media and Data Integrity Errors' | awk '{print $NF}')
            local du_read=$(echo "$smart_out" | grep -i 'Data Units Read' | awk '{print $NF}')
            local du_written=$(echo "$smart_out" | grep -i 'Data Units Written' | awk '{print $NF}')
            local unsafe_shutdowns=$(echo "$smart_out" | grep -i 'Unsafe Shutdowns' | awk '{print $NF}')
            local temp=$(echo "$smart_out" | grep -i 'Temperature' | grep -oE '[0-9]+' | head -1)

            [[ "$crit_warn" != "0" && -n "$crit_warn" ]] && { log_entry "SMART" "ERROR" "Critical Warning: $crit_warn"; score_sub "SMART" 20; }
            [[ -n "$pct_used" ]] && {
                log_entry "SMART" "INFO" "Percentage Used: ${pct_used}%"
                safe_compare "$pct_used" ">=" "90" && { log_entry "SMART" "ERROR" "Desgaste avançado do NVMe"; score_sub "SMART" 15; }
            }
            [[ -n "$avail_spare" ]] && log_entry "SMART" "INFO" "Available Spare: ${avail_spare}%"
            [[ -n "$media_err" && "$(safe_int "$media_err")" -gt 0 ]] && { log_entry "SMART" "ERROR" "Media Errors: $media_err"; score_sub "SMART" 10; }
            [[ -n "$du_read" ]] && log_entry "SMART" "INFO" "Data Units Read: $du_read"
            [[ -n "$du_written" ]] && log_entry "SMART" "INFO" "Data Units Written: $du_written"
            [[ -n "$unsafe_shutdowns" && "$(safe_int "$unsafe_shutdowns")" -gt 10 ]] && log_entry "SMART" "WARN" "Unsafe Shutdowns elevados: $unsafe_shutdowns"
            [[ -n "$temp" ]] && log_entry "SMART" "INFO" "Temperatura: ${temp}°C"
        else
            local health=$(echo "$smart_out" | grep -i 'SMART overall-health' | grep -i 'PASSED\|OK')
            local realloc=$(echo "$smart_out" | grep -i 'Reallocated_Sector_Ct' | awk '{print $NF}')
            local pending=$(echo "$smart_out" | grep -i 'Current_Pending_Sector' | awk '{print $NF}')
            local offline=$(echo "$smart_out" | grep -i 'Offline_Uncorrectable' | awk '{print $NF}')
            local crc=$(echo "$smart_out" | grep -i 'UDMA_CRC_Error_Count' | awk '{print $NF}')
            local poh=$(echo "$smart_out" | grep -i 'Power_On_Hours' | awk '{print $NF}')
            local pcycles=$(echo "$smart_out" | grep -i 'Power_Cycle_Count' | awk '{print $NF}')
            local temp=$(echo "$smart_out" | grep -i 'Temperature_Celsius' | awk '{print $10}')

            [[ -n "$health" ]] && log_entry "SMART" "OK" "Health: PASSED" || { log_entry "SMART" "ERROR" "Health: FAILED"; score_sub "SMART" 30; }
            [[ "$(safe_int "$realloc")" -gt 0 ]] && { log_entry "SMART" "WARN" "Setores realocados: $realloc"; score_sub "SMART" 10; }
            [[ "$(safe_int "$pending")" -gt 0 ]] && { log_entry "SMART" "ERROR" "Setores pendentes: $pending"; score_sub "SMART" 15; }
            [[ "$(safe_int "$offline")" -gt 0 ]] && { log_entry "SMART" "ERROR" "Offline uncorrectable: $offline"; score_sub "SMART" 10; }
            [[ "$(safe_int "$crc")" -gt 0 ]] && { log_entry "SMART" "WARN" "CRC Errors: $crc (verifique cabo SATA)"; score_sub "SMART" 5; }
            [[ -n "$poh" ]] && log_entry "SMART" "INFO" "Power On Hours: $poh"
            [[ -n "$pcycles" ]] && log_entry "SMART" "INFO" "Power Cycles: $pcycles"
            [[ -n "$temp" ]] && log_entry "SMART" "INFO" "Temperatura: ${temp}°C"
        fi
    done
}

check_network() {
    log_entry "Network" "HEADER" "Rede e Conectividade"
    
    local ifaces=$(run_cmd ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | grep -E '^(eno|enp|eth|wlan|wlp)' | grep -v '@')
    local count=$(echo "$ifaces" | grep -c . || echo "0")
    
    log_entry "Network" "INFO" "Interfaces físicas detectadas: $count"
    [[ "$count" -lt 2 ]] && log_entry "Network" "WARN" "Menos de 2 interfaces físicas detectadas"

    for iface in $ifaces; do
        local state=$(cat "/sys/class/net/$iface/operstate" 2>/dev/null || echo "unknown")
        local ip4=$(run_cmd ip -4 addr show "$iface" 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1)
        local speed=$(cat "/sys/class/net/$iface/speed" 2>/dev/null || echo "N/A")
        local rx_err=$(cat "/sys/class/net/$iface/statistics/rx_errors" 2>/dev/null || echo "0")
        local tx_err=$(cat "/sys/class/net/$iface/statistics/tx_errors" 2>/dev/null || echo "0")
        local rx_drop=$(cat "/sys/class/net/$iface/statistics/rx_dropped" 2>/dev/null || echo "0")
        local tx_drop=$(cat "/sys/class/net/$iface/statistics/tx_dropped" 2>/dev/null || echo "0")
        
        log_entry "Network" "INFO" "$iface: state=$state speed=${speed}Mbps ip=$ip4 | Erros: RX=$rx_err TX=$tx_err | Drops: RX=$rx_drop TX=$tx_drop"
        if [[ "$(safe_int "$rx_err")" -gt 0 || "$(safe_int "$tx_err")" -gt 0 ]]; then
            log_entry "Network" "WARN" "Erros de hardware na interface $iface"
            score_sub "Network" 5
        fi
    done

    local gateway

    gateway="$(network_get_gateway)"

    if network_ping_gateway; then

        log_entry "Network" "OK" \
            "Gateway $gateway acessível"

    else

        log_entry "Network" "ERROR" \
            "Gateway inacessível"

        score_sub "Network" 10

    fi
if network_ping_internet; then

    log_entry "Network" "OK" \
        "Internet OK"

else

    log_entry "Network" "ERROR" \
        "Sem internet"

    score_sub "Network" 10
    fi 

    if network_check_dns; then

        log_entry "Network" "OK" \
            "Resolução DNS funcionando"

    else

        log_entry "Network" "ERROR" \
            "Falha na resolução DNS"

        score_sub "Network" 10

    fi
}

check_services_and_security() {
    log_entry "Security" "HEADER" "Serviços e Segurança"
    
    local ssh_active=0
    local ssh_method=""
    
    for svc in ssh sshd; do
        if run_cmd systemctl is-active --quiet "$svc" 2>/dev/null; then
            ssh_active=1
            ssh_method="service ($svc)"
            break
        fi
    done
    
    if [[ "$ssh_active" -eq 0 ]]; then
        if run_cmd systemctl is-active --quiet ssh.socket 2>/dev/null; then
            ssh_active=1
            ssh_method="socket (ssh.socket)"
        fi
    fi
    
    if [[ "$ssh_active" -eq 0 ]]; then
        local port_22=$(run_cmd ss -tlnp 2>/dev/null | grep -cE ':22\s|:22$' || echo "0")
        if [[ "$(safe_int "$port_22")" -gt 0 ]]; then
            ssh_active=1
            ssh_method="porta 22 ativa"
        fi
    fi
    
    if [[ "$ssh_active" -eq 1 ]]; then
        log_entry "Security" "OK" "SSH ativo e escutando (detectado via $ssh_method)"
    else
        log_entry "Security" "WARN" "SSH não detectado como ativo"
    fi

    if command -v ufw &>/dev/null; then
        local ufw_status=$(run_cmd sudo ufw status 2>/dev/null | head -1)
        if echo "$ufw_status" | grep -qi 'active'; then
            log_entry "Security" "OK" "UFW Ativo"
        else
            log_entry "Security" "WARN" "UFW Inativo"
            score_sub "Security" 10
        fi
    fi

    run_cmd systemctl is-active --quiet fail2ban && log_entry "Security" "OK" "Fail2ban Ativo" || log_entry "Security" "INFO" "Fail2ban Inativo/Não instalado"
    run_cmd aa-status &>/dev/null && log_entry "Security" "OK" "AppArmor Ativo" || log_entry "Security" "INFO" "AppArmor Inativo"
    run_cmd systemctl is-active --quiet auditd && log_entry "Security" "OK" "Auditd Ativo" || log_entry "Security" "INFO" "Auditd Inativo/Não instalado"
    local sim_upgrade
    sim_upgrade="$(
        run_cmd apt-get -s upgrade 2>/dev/null |
        grep -E '^Inst |^Conf ' || true
    )"

    local upd_count
upd_count="$(
    printf '%s\n' "$sim_upgrade" |
    grep -c '^Inst' || true
)"

sec_count="$(
    printf '%s\n' "$sim_upgrade" |
    grep -ci 'security' || true
)"

local kern_count
kern_count="$(
    printf '%s\n' "$sim_upgrade" |
    grep -ciE 'linux-image|linux-headers' || true
)"

    upd_count=$(printf '%s' "$upd_count" | head -n1 | tr -d '[:space:]')
    sec_count=$(printf '%s' "$sec_count" | head -n1 | tr -d '[:space:]')
    kern_count=$(printf '%s' "$kern_count" | head -n1 | tr -d '[:space:]')

log_entry "Security" "INFO" \
    "Atualizações pendentes: $upd_count (Segurança: $sec_count, Kernel: $kern_count)"

if [[ "$(safe_int "$sec_count")" -gt 0 ]]; then
    log_entry "Security" "WARN" \
        "Existem atualizações de segurança pendentes"
    score_sub "Security" 5
fi
    log_entry "Security" "SUB" "Verificações de Segurança do Sistema"
    local suid_count=$(run_cmd find /usr /etc -perm -4000 -type f 2>/dev/null | wc -l || echo "0")
    log_entry "Security" "INFO" "Arquivos SUID em /usr e /etc: $suid_count"
    
    local ww_count=$(run_cmd find /usr /etc -perm -0002 -type f 2>/dev/null | wc -l || echo "0")
    if [[ "$(safe_int "$ww_count")" -gt 0 ]]; then
        log_entry "Security" "WARN" "Arquivos com permissão World Writable em /usr ou /etc: $ww_count"
        score_sub "Security" 5
    fi

    local sudo_users=$(run_cmd getent group sudo | cut -d: -f4)
    log_entry "Security" "INFO" "Usuários no grupo sudo: ${sudo_users:-Nenhum}"

    local failed_logins=$(run_cmd lastb 2>/dev/null | wc -l || echo "0")
    failed_logins=$((failed_logins > 2 ? failed_logins - 2 : 0))
    log_entry "Security" "INFO" "Tentativas de login falhas (lastb): $failed_logins"
}

